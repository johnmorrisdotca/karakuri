{
  "name": "@johnmorrisdotca/karakuri",
  "version": "0.1.2",
  "description": "Karakuri からくり — Physics and hyper-casual puzzle games: eight puzzle games, native rules and solvers, deterministic 2D physics, level lists and pointer/keyboard play in English and Japanese. Zero dependencies.",
  "keywords": [
    "browser",
    "canvas",
    "casual-games",
    "custom-element",
    "hyper-casual",
    "itsutsu",
    "javascript",
    "keyboard",
    "levels",
    "physics",
    "physics-game",
    "physics-puzzle",
    "puzzle",
    "puzzle-game",
    "puzzle-games",
    "sliding-block",
    "tube-sort",
    "typescript",
    "web-component",
    "zero-dependencies"
  ],
  "homepage": "https://johnmorrisdotca.github.io/karakuri/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/karakuri.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/karakuri/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./physics": {
      "types": "./dist/physics-entry.d.ts",
      "import": "./dist/physics-entry.js",
      "default": "./dist/physics-entry.js"
    },
    "./levels": {
      "types": "./dist/levels.d.ts",
      "import": "./dist/levels.js",
      "default": "./dist/levels.js"
    },
    "./play": {
      "types": "./dist/play-entry.d.ts",
      "import": "./dist/play-entry.js",
      "default": "./dist/play-entry.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "docs:make": "node scripts/docs.mjs",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint-plugin-unicorn": "^56.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0",
    "pagefind": "^1.5.2",
    "marked": "^18.0.0",
    "esbuild": "^0.28.0"
  },
  "packageManager": "pnpm@10.11.0"
}
